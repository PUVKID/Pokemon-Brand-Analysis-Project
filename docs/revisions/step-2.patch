+    "def norm_platform(x):\n",
+    "    s = str(x).strip().lower()\n",
+    "    if s in (\"\", \"nan\"): return np.nan\n",
+    "    if any(k in s for k in [\"유튜브\", \"youtube\", \"油管\"]): return \"YouTube\"\n",
